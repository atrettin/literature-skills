# Copy to .env and fill in. Compose reads it on `docker compose up`.

# The address users reach the server at. Rendered reports link to it.
BASE_URL=https://example.org/literature

# The prefix the reverse proxy serves the app under; empty when it serves the
# whole host.
ROOT_PATH=/literature

# The host address and port the container is published on. The default only
# accepts connections from this machine, which suits a reverse proxy on the
# same host.
PUBLISH=127.0.0.1:8000
